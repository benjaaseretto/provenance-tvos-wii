# Copiá este archivo a config.env y completalo. config.env no se sube a git.

# UDID del Apple TV: xcrun devicectl list devices
ATV_UDID=00000000-0000000000000000
# IP del Apple TV en tu red local
ATV_IP=192.168.1.100
# Team ID de tu Apple ID (Xcode > Settings > Accounts), 10 caracteres
TEAM_ID=XXXXXXXXXX
# Prefijo de tus bundle IDs, por ejemplo com.tunombre
BUNDLE_PREFIX=com.tunombre
# Python con pyatv instalado (opcional; por defecto python3)
# ATV_PYTHON=~/.venv-atv/bin/python
# Ruta al IPA de Provenance para tvOS (descargalo de los releases oficiales)
PROVENANCE_IPA=./Provenance-tvOS.ipa
